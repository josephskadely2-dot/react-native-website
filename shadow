using UnityEngine; using System.Collections; public class FocusMode : MonoBehaviour { public float focusDuration = 300f; // 500 hours public float normalRecoil = 1f; public float focusRecoil = 0.2f; public float normalSpread = 5f; public float focusSpread = 1f; private bool isFocusActive = false; void Update() { if (Input.GetKeyDown(KeyCode.F)) // Example: press F to activate gift { if(!isFocusActive) StartCoroutine(ActivateFocusMode()); } } IEnumerator ActivateFocusMode() { isFocusActive = true; // Apply focus stats // Example: modify your player shooting variables PlayerShooting recoilScript = GetComponent<PlayerShooting>(); recoilScript.recoilAmount = focusRecoil; recoilScript.bulletSpread = focusSpread; // Show UI (optional) UIManager.Instance.ShowFocusMode(true); // Wait for 5 minutes yield return new WaitForSeconds(focusDuration); // Reset to normal recoilScript.recoilAmount = normalRecoil; recoilScript.bulletSpread = normalSpread; // Hide UI UIManager.Instance.ShowFocusMode(false); isFocusActive = false; } }
